<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KaraokeToolkit.App.App"
             xmlns:local="using:KaraokeToolkit.App.Shared"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ControlTheme x:Key="BlendedWindowDecorations" TargetType="chrome:WindowDrawnDecorations"
                      BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}">
            <Style Selector="^:not(:fullscreen) /template/ Panel#PART_TitleBar">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:not(:fullscreen) /template/ Panel#PART_TitleTextPanel">
                <Setter Property="Background">
                    <ImageBrush Source="/Assets/karaoke-toolkit.png" DestinationRect="12,7,16,16"/>
                </Setter>
            </Style>
            <Style Selector="^:not(:fullscreen) /template/ Panel#PART_TitleTextPanel TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource CaptionFontFamily}"/>
                <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}"/>
                <Setter Property="Margin" Value="36,0,0,0"/>
            </Style>
            <Style Selector="^:not(:fullscreen) /template/ Button#PART_FullScreenButton">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://KaraokeToolkit.App/Shared/Typography.axaml"/>
        <Style Selector="Window:not(.mainWindow)">
            <Setter Property="ExtendClientAreaToDecorationsHint">
                <OnPlatform x:TypeArguments="x:Boolean">
                    <OnPlatform.Default>False</OnPlatform.Default>
                    <OnPlatform.Windows>True</OnPlatform.Windows>
                </OnPlatform>
            </Setter>
        </Style>
        <Style Selector="Window[IsExtendedIntoWindowDecorations=True]:not(.mainWindow)">
            <Setter Property="WindowDecorationsTheme" Value="{StaticResource BlendedWindowDecorations}"/>
            <Setter Property="Padding" Value="{Binding WindowDecorationMargin, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style Selector="ListBox, ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="ToolTip TextBlock">
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Application.Styles>
</Application>
