<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>KaraokeToolkit.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\karaoke-toolkit.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\licenses\ModelContextProtocol*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KaraokeToolkit.Core\KaraokeToolkit.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\licenses\README.md" Link="licenses\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\licenses\Velopack.txt" Link="licenses\Velopack.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\licenses\Avalonia.txt;..\licenses\Inter.OFL.txt;..\licenses\CommunityToolkit.Mvvm.txt;..\licenses\CommunityToolkit.Mvvm.ThirdPartyNotices.txt;..\licenses\SkiaSharp.txt;..\licenses\HarfBuzzSharp.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\licenses\Instances.txt;..\licenses\MicroCom.Runtime.txt;..\licenses\Microsoft.Extensions*.txt;..\licenses\Microsoft.IO.RecyclableMemoryStream.txt;..\licenses\Tmds.DBus.Protocol.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\licenses\ANGLE.txt" Link="licenses\ANGLE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win-')))" />
  </ItemGroup>
</Project>

