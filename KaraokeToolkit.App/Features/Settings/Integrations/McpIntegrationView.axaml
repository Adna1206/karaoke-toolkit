<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KaraokeToolkit.App.Features.Settings.Integrations"
             x:Class="KaraokeToolkit.App.Features.Settings.Integrations.McpIntegrationView"
             x:DataType="vm:McpIntegrationViewModel">
        <StackPanel Margin="0,12,0,8" Spacing="12">
            <TextBlock Text="Connect an AI client to local toolkit operations." TextWrapping="Wrap"
                       ToolTip.Tip="Your client launches the MCP executable and communicates over stdin/stdout. No hosted server, listening port or background service is needed."/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding ExecutablePath, Mode=OneWay}" IsReadOnly="True"
                         AutomationProperties.Name="MCP executable path" ToolTip.Tip="{Binding ExecutablePath}"/>
                <Button Grid.Column="1" Content="Copy Path" Click="CopyPath_Click"/>
            </Grid>
            <TextBlock Text="{Binding Availability}" IsVisible="{Binding IsMissing}" TextWrapping="Wrap" FontSize="{DynamicResource SmallTextSize}" Opacity="0.7"/>
            <Expander Header="Client configuration" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" Margin="0,10,0,0">
            <TextBlock Text="File access for copied configuration"/>
            <ComboBox ItemsSource="{Binding FileAccessModes}" SelectedItem="{Binding FileAccess}" Width="260" HorizontalAlignment="Left"
                      AutomationProperties.Name="MCP file access"
                      ToolTip.Tip="Read only by default. Allow file changes adds --allow-writes so an agent can convert, tag, organise and recover files. Each changing call still requires confirmFileChanges=true for authorized work. This does not change an already-running MCP process."/>
            <TextBlock Text="Read only permits checks and previews. Allow file changes also permits conversions and other file changes." TextWrapping="Wrap" FontSize="{DynamicResource SmallTextSize}" Opacity="0.7"/>
            <Button Content="Copy Client Configuration" Click="CopyConfiguration_Click" HorizontalAlignment="Left"
                    ToolTip.Tip="Copy a generic mcpServers JSON entry. Add it to your client's MCP configuration, then reconnect or restart that client."/>
                    <TextBox Text="{Binding ConfigurationJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="220" FontFamily="Consolas, Menlo, monospace" AutomationProperties.Name="MCP client configuration"/>
                    <TextBlock Text="Add this entry to your client's MCP configuration. Some clients use a different configuration format; use the same command and arguments. Reconnect after changing it."
                               TextWrapping="Wrap" FontSize="{DynamicResource SmallTextSize}" Opacity="0.7"/>
            <TextBlock Text="This choice changes the copied example only. It does not start MCP, save a global permission or modify your client settings." TextWrapping="Wrap" FontSize="{DynamicResource SmallTextSize}" Opacity="0.7"/>
                </StackPanel>
            </Expander>
            <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" FontSize="{DynamicResource SmallTextSize}" AutomationProperties.Name="MCP integration status"/>
        </StackPanel>
</UserControl>
