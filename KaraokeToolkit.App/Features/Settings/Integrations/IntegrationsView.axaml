<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:integrations="using:KaraokeToolkit.App.Features.Settings.Integrations"
             x:Class="KaraokeToolkit.App.Features.Settings.Integrations.IntegrationsView">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,20,12,20" Spacing="16">
            <Expander Header="Command Line (CLI)" IsExpanded="True" HorizontalAlignment="Stretch">
                <integrations:CliIntegrationView/>
            </Expander>
            <Expander Header="Model Context Protocol (MCP)" IsExpanded="True" HorizontalAlignment="Stretch">
                <integrations:McpIntegrationView/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
