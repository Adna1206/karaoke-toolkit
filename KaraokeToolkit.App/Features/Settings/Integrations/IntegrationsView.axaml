<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:integrations="using:KaraokeToolkit.App.Features.Settings.Integrations"
             xmlns:vm="using:KaraokeToolkit.App.Features.Settings"
             xmlns:services="using:KaraokeToolkit.App.Services"
             x:Class="KaraokeToolkit.App.Features.Settings.Integrations.IntegrationsView" x:DataType="vm:OptionsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,20,12,20" Spacing="16">
            <Expander Header="Windows Explorer" x:Name="ExplorerSection" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Static services:ExplorerIntegration.MenuLabel}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Definitions.ExplorerOverview.Label}" TextWrapping="Wrap" ToolTip.Tip="{Binding Definitions.ExplorerOverview.Description}"/>
                    <TextBlock Text="{Binding Definitions.ExplorerLocation.Label}" TextWrapping="Wrap" Opacity="0.75" ToolTip.Tip="{Binding Definitions.ExplorerLocation.Description}"/>
                    <TextBlock x:Name="ExplorerStatus" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="{Binding Definitions.EnableExplorer.Label}" Click="EnableExplorer_Click" ToolTip.Tip="{Binding Definitions.EnableExplorer.Description}"/>
                        <Button Content="{Binding Definitions.RemoveExplorer.Label}" Click="RemoveExplorer_Click" ToolTip.Tip="{Binding Definitions.RemoveExplorer.Description}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Definitions.ExplorerImmediate.Label}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" ToolTip.Tip="{Binding Definitions.ExplorerImmediate.Description}"/>
                </StackPanel>
            </Expander>
            <Expander Header="Command Line Interface (CLI)" IsExpanded="True" HorizontalAlignment="Stretch">
                <integrations:CliIntegrationView/>
            </Expander>
            <Expander Header="Model Context Protocol (MCP)" IsExpanded="True" HorizontalAlignment="Stretch">
                <integrations:McpIntegrationView/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
