<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" d:DesignWidth="620" d:DesignHeight="220"
             xmlns:vm="using:KaraokeToolkit.App.Features.Main"
             xmlns:shared="using:KaraokeToolkit.App.Shared"
             x:Class="KaraokeToolkit.App.Features.Main.ActivityLogView" x:DataType="vm:MainViewModel">
 <shared:TableView>
  <shared:TableView.Header>
    <Grid ColumnDefinitions="90,*">
     <TextBlock Text="Time"/>
     <TextBlock Grid.Column="1" Text="Event"/>
    </Grid>
  </shared:TableView.Header>
  <shared:TableView.Rows>
   <ListBox x:Name="ActivityLog" Classes="tableItems" ItemsSource="{Binding Activity}" AutomationProperties.Name="Progress event log">
    <ListBox.ItemTemplate>
     <DataTemplate x:DataType="vm:ActivityEntry">
      <Border Classes="tableRow">
       <Grid ColumnDefinitions="90,*">
        <TextBlock Text="{Binding Time}" Opacity="0.65"/>
        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"/>
       </Grid>
      </Border>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </shared:TableView.Rows>
 </shared:TableView>
</UserControl>
