<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:KaraokeToolkit.Core"
 xmlns:vm="using:KaraokeToolkit.App.Features.Main" xmlns:chrome="using:Avalonia.Controls.Chrome"
 x:Class="KaraokeToolkit.App.Features.Main.MainWindow" x:DataType="vm:MainViewModel"
 Classes="mainWindow" Icon="/Assets/karaoke-toolkit.ico" Title="{x:Static core:ApplicationInfo.Name}" Width="1000" Height="700" MinWidth="900" MinHeight="620">
 <Window.Styles>
  <Style Selector="Menu#MainMenu MenuItem">
   <Setter Property="Margin" Value="2,4"/>
   <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Menu#MainMenu.titleBar > MenuItem">
   <Setter Property="FontFamily" Value="{DynamicResource CaptionFontFamily}"/>
   <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}"/>
   <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style Selector="Menu#MainMenu MenuItem MenuItem">
   <Setter Property="FontSize" Value="{DynamicResource DropdownMenuFontSize}"/>
  </Style>
  <Style Selector="Border.status.success">
   <Setter Property="Background" Value="#262FA855"/>
   <Setter Property="BorderBrush" Value="#2FA855"/>
  </Style>
  <Style Selector="Border.status.warning">
   <Setter Property="Background" Value="#26D69B23"/>
   <Setter Property="BorderBrush" Value="#D69B23"/>
  </Style>
  <Style Selector="Border.status.failure">
   <Setter Property="Background" Value="#26DC4545"/>
   <Setter Property="BorderBrush" Value="#DC4545"/>
  </Style>
  <Style Selector="ListBox.operations ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.favourite">
   <Setter Property="Foreground" Value="#D69B23"/>
  </Style>
 </Window.Styles>
 <Window.Resources>
  <ControlTheme x:Key="MainWindowDecorations" TargetType="chrome:WindowDrawnDecorations"
                BasedOn="{StaticResource BlendedWindowDecorations}">
   <Style Selector="^:not(:fullscreen) /template/ Panel#PART_TitleTextPanel">
    <Setter Property="IsVisible" Value="False"/>
   </Style>
  </ControlTheme>
  <DataTemplate x:Key="OperationTemplate" x:DataType="vm:ActionChoice">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="6,4">
    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Background="Transparent"
               ToolTip.Tip="{Binding Description}" />
    <Button Grid.Column="1" Command="{Binding ToggleFavouriteCommand}"
            Classes.favourite="{Binding IsFavourite}" ToolTip.Tip="{Binding FavouriteHint}"
            AutomationProperties.Name="{Binding FavouriteAccessibleName}"
            Width="32" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center">
     <Grid Width="18" Height="18">
      <Path Data="M12,2 L15,8.5 L22,9.5 L17,14.5 L18,22 L12,18.5 L6,22 L7,14.5 L2,9.5 L9,8.5 Z"
            Stretch="Uniform" StrokeThickness="1.5" Fill="Transparent"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Path Data="M12,2 L15,8.5 L22,9.5 L17,14.5 L18,22 L12,18.5 L6,22 L7,14.5 L2,9.5 L9,8.5 Z"
            Stretch="Uniform" StrokeThickness="1.5" IsVisible="{Binding IsFavourite}"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
     </Grid>
    </Button>
   </Grid>
  </DataTemplate>
 </Window.Resources>
 <Grid RowDefinitions="Auto,Auto,*,Auto">
  <Grid x:Name="MenuRow" ColumnDefinitions="Auto,Auto,*">
   <StackPanel x:Name="TitleBarIdentity" IsVisible="False" Orientation="Horizontal" Spacing="8"
               Margin="24,0,12,0" Background="Transparent">
    <Image Source="/Assets/karaoke-toolkit.png" Width="20" Height="20" VerticalAlignment="Center"/>
    <TextBlock Text="{x:Static core:ApplicationInfo.Name}" VerticalAlignment="Center"
               FontFamily="{DynamicResource CaptionFontFamily}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="Normal"/>
   </StackPanel>
   <Menu x:Name="MainMenu" Grid.ColumnSpan="3">
    <MenuItem Header="_File">
     <MenuItem Header="View Last Run _Report…" Click="Results_Click" IsEnabled="{Binding CanViewReport}"/>
     <Separator/>
     <MenuItem Header="E_xit" Click="Exit_Click" IsEnabled="{Binding CanEdit}"/>
    </MenuItem>
    <MenuItem Header="_Tools">
     <MenuItem Header="_Recipe Builder (Experimental)…" Click="Recipes_Click" IsEnabled="{Binding CanEdit}"/>
     <MenuItem Header="_Settings…" Click="Options_Click" IsEnabled="{Binding CanEdit}"/>
    </MenuItem>
    <MenuItem Header="_Help">
     <MenuItem Header="_Help" Click="Help_Click"/>
     <MenuItem Header="_About…" Click="About_Click"/>
    </MenuItem>
   </Menu>
   <Border x:Name="TitleBarDragArea" Grid.Column="2" Background="Transparent" IsVisible="False"/>
  </Grid>
  <Border x:Name="MainHeader" Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="24,14">
   <DockPanel>
    <Image DockPanel.Dock="Left" Source="/Assets/karaoke-toolkit.png" Width="40" Height="40" Margin="0,0,12,0"/>
    <StackPanel VerticalAlignment="Center" Spacing="2">
     <TextBlock Text="{x:Static core:ApplicationInfo.Name}" Classes="heading1"/>
     <TextBlock Text="Convert, validate and organise your karaoke collection." FontSize="{DynamicResource SmallTextSize}" Opacity="0.65"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2" Margin="24,20" ColumnDefinitions="190,*" ColumnSpacing="24"
        RowDefinitions="Auto,*" RowSpacing="12" IsVisible="{Binding !ShowProgress}">
   <TextBlock Text="Tools" Classes="heading2" Margin="8,0"/>
   <TextBlock Grid.Column="1" Text="{Binding SelectedSectionTitle}" Classes="heading2"/>
   <ListBox Grid.Row="1" x:Name="CategoryList" ItemsSource="{Binding VisibleSections}" SelectedItem="{Binding SelectedSection, Mode=OneWay}" SelectionChanged="Category_SelectionChanged"
            IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Operation categories">
    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:OperationSectionViewModel">
     <TextBlock Text="{Binding Header}" TextWrapping="Wrap" Margin="4,6"/>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,Auto,Auto" RowSpacing="14">
    <ListBox x:Name="OperationList" Classes="operations" ItemsSource="{Binding VisibleOperations}"
             SelectedItem="{Binding SelectedOperation, Mode=OneWay}" SelectionChanged="Operation_SelectionChanged"
             ItemTemplate="{StaticResource OperationTemplate}" IsEnabled="{Binding CanEdit}"
             AutomationProperties.Name="Operations"/>
    <Border Grid.Row="1" Padding="0,4,0,0">
     <ScrollViewer MaxHeight="85" HorizontalScrollBarVisibility="Disabled">
      <TextBlock Text="{Binding ActionDescription}" TextWrapping="Wrap" FontSize="{DynamicResource SmallTextSize}" Opacity="0.75"/>
     </ScrollViewer>
    </Border>
    <Border Grid.Row="2" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
     <Grid>
      <StackPanel Spacing="8" IsVisible="{Binding NeedsSource}">
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Clear" Command="{Binding ClearInputsCommand}" Padding="10,4"
                AutomationProperties.Name="Clear selected files and folders"/>
       </Grid>
       <TextBox Text="{Binding FolderPath}" IsEnabled="{Binding CanChooseSource}" PlaceholderText="Choose a source or type a path…"
                AutomationProperties.Name="{Binding SourceLabel}"/>
       <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
        <Button Content="Add Folders…" Click="BrowseFolder_Click" IsEnabled="{Binding CanChooseSource}"/>
        <Button Grid.Column="1" Content="Add Files…" Click="BrowseFiles_Click" IsEnabled="{Binding CanChooseFiles}"/>
       </Grid>
       <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" MaxHeight="36" FontSize="{DynamicResource SmallTextSize}" Opacity="0.65" ToolTip.Tip="{Binding SourceSummary}"/>
      </StackPanel>
      <TextBlock Text="{Binding SourceInstruction}" IsVisible="{Binding !NeedsSource}" TextWrapping="Wrap"/>
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="24,16" IsVisible="{Binding ShowProgress}" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
   <TextBlock Text="{Binding RunTitle}" Classes="heading1" />
   <TextBlock Grid.Row="1" Text="{Binding FolderPath}" TextTrimming="CharacterEllipsis" />
   <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
    <Grid ColumnDefinitions="90,*"><TextBlock Text="Time" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Event" FontWeight="SemiBold"/></Grid>
    <ListBox Grid.Row="1" x:Name="ActivityLog" ItemsSource="{Binding Activity}" AutomationProperties.Name="Progress event log"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:ActivityEntry">
     <Grid ColumnDefinitions="90,*" Margin="2,2"><TextBlock Text="{Binding Time}" Opacity="0.65"/><TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"/></Grid>
    </DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
   <StackPanel Grid.Row="3" Spacing="9">
    <TextBlock Text="Current Progress" FontWeight="SemiBold" />
    <Grid ColumnDefinitions="110,*,45" ColumnSpacing="10"><TextBlock Text="Item Progress:"/><ProgressBar Grid.Column="1" Value="{Binding Progress}" Maximum="100"/><TextBlock Grid.Column="2" Text="{Binding Progress, StringFormat='{}{0}%'}"/></Grid>
    <Grid ColumnDefinitions="110,*,45" ColumnSpacing="10"><TextBlock Text="Total Progress:"/><ProgressBar Grid.Column="1" Value="{Binding TotalProgress}" Maximum="100"/><TextBlock Grid.Column="2" Text="{Binding TotalProgress, StringFormat='{}{0}%'}"/></Grid>
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Elapsed, StringFormat='Elapsed Time: {0}'}"/><TextBlock Grid.Column="1" Text="{Binding FoundFiles, StringFormat='Files found: {0}'}"/></Grid>
   </StackPanel>
  </Grid>
  <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="24,14">
   <StackPanel Spacing="12">
    <Grid IsVisible="{Binding RecoveryAvailable}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
     <TextBlock Text="{Binding RecoveryMessage}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/>
     <Button Grid.Column="1" Content="Recover…" Command="{Binding CheckRecoveryCommand}" IsEnabled="{Binding CanEdit}"/>
    </Grid>
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
     <Border Classes="status" Classes.success="{Binding StatusSucceeded}" Classes.warning="{Binding StatusWarning}" Classes.failure="{Binding StatusFailed}"
             Padding="10,6" CornerRadius="4" BorderThickness="3,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="42" FontSize="{DynamicResource SmallTextSize}"/>
     </Border>
     <Button Grid.Column="1" Content="View Last Run Report…" Click="Results_Click" IsEnabled="{Binding CanViewReport}"/>
     <Button Grid.Column="2" Content="Back" Click="Back_Click" IsVisible="{Binding ShowProgress}" IsEnabled="{Binding CanEdit}"/>
     <Grid Grid.Column="3">
      <Button Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding !IsBusy}" MinWidth="105" Classes="accent"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" MinWidth="105"/>
     </Grid>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>
