<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="using:KaraokeToolkit.App.Shared" xmlns:core="using:KaraokeToolkit.Core"
 xmlns:vm="using:KaraokeToolkit.App.Features.Main" xmlns:chrome="using:Avalonia.Controls.Chrome"
 x:Class="KaraokeToolkit.App.Features.Main.MainWindow" x:DataType="vm:MainViewModel"
 Classes="mainWindow" Icon="/Assets/karaoke-toolkit.ico" Title="{x:Static core:ApplicationInfo.Name}" Width="1000" Height="700" MinWidth="900" MinHeight="620">
 <Window.Styles>
  <Style Selector="Menu#MainMenu MenuItem">
   <Setter Property="Margin" Value="2,4"/>
   <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Menu#MainMenu.titleBar > MenuItem">
   <Setter Property="FontFamily" Value="{DynamicResource CaptionFontFamily}"/>
   <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}"/>
   <Setter Property="FontWeight" Value="Normal"/>
  </Style>
 </Window.Styles>
 <Window.Resources>
  <ControlTheme x:Key="MainWindowDecorations" TargetType="chrome:WindowDrawnDecorations"
                BasedOn="{StaticResource BlendedWindowDecorations}">
   <Style Selector="^:not(:fullscreen) /template/ Panel#PART_TitleTextPanel">
    <Setter Property="IsVisible" Value="False"/>
   </Style>
  </ControlTheme>
 </Window.Resources>
 <Grid RowDefinitions="Auto,Auto,*">
  <Grid x:Name="MenuRow" ColumnDefinitions="Auto,Auto,*">
   <StackPanel x:Name="TitleBarIdentity" IsVisible="False" Orientation="Horizontal" Spacing="8"
               Margin="24,0,12,0" Background="Transparent">
    <Image Source="/Assets/karaoke-toolkit.png" Width="20" Height="20" VerticalAlignment="Center"/>
    <TextBlock Text="{x:Static core:ApplicationInfo.Name}" VerticalAlignment="Center"
               FontFamily="{DynamicResource CaptionFontFamily}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="Normal"/>
   </StackPanel>
   <Menu x:Name="MainMenu" Grid.ColumnSpan="3">
    <MenuItem Header="_File">
     <MenuItem Header="View Last Run _Report…" Click="Results_Click" IsEnabled="{Binding CanViewReport}">
      <MenuItem.Icon><PathIcon Classes="menuGlyph" Data="{x:Static shared:DialogArtwork.Report}"/></MenuItem.Icon>
     </MenuItem>
     <Separator/>
     <MenuItem Header="E_xit" Click="Exit_Click">
      <MenuItem.Icon><PathIcon Classes="menuGlyph" Data="{x:Static shared:DialogArtwork.Exit}"/></MenuItem.Icon>
     </MenuItem>
    </MenuItem>
    <MenuItem Header="_Tools">
     <MenuItem Header="_Recipe Builder (Experimental)…" Click="Recipes_Click" IsEnabled="{Binding CanEdit}">
      <MenuItem.Icon><PathIcon Classes="menuGlyph" Data="{x:Static shared:DialogArtwork.Recipe}"/></MenuItem.Icon>
     </MenuItem>
     <MenuItem Header="Rip _CD+G (Experimental)…" Command="{Binding RunDiscRipCommand}"
               IsVisible="{Binding Options.ExperimentalDiscRipping}">
      <MenuItem.Icon><PathIcon Classes="menuGlyph" Data="{x:Static shared:DialogArtwork.DiscRip}"/></MenuItem.Icon>
     </MenuItem>
     <MenuItem Header="_Settings…" Click="Options_Click" IsEnabled="{Binding CanEdit}">
      <MenuItem.Icon><PathIcon Classes="menuGlyph" Data="{x:Static shared:DialogArtwork.Settings}"/></MenuItem.Icon>
     </MenuItem>
    </MenuItem>
    <MenuItem Header="_Help">
     <MenuItem Header="_Help" Click="Help_Click">
      <MenuItem.Icon><PathIcon Classes="menuGlyph" Data="{x:Static shared:DialogArtwork.Help}"/></MenuItem.Icon>
     </MenuItem>
     <MenuItem x:Name="CheckForUpdatesMenuItem" Header="Check for _updates…" Click="CheckForUpdates_Click">
      <MenuItem.Icon><PathIcon Classes="menuGlyph" Data="{x:Static shared:DialogArtwork.Update}"/></MenuItem.Icon>
     </MenuItem>
     <MenuItem Header="_About…" Click="About_Click">
      <MenuItem.Icon><PathIcon Classes="menuGlyph" Data="{x:Static shared:DialogArtwork.About}"/></MenuItem.Icon>
     </MenuItem>
    </MenuItem>
   </Menu>
   <Border x:Name="TitleBarDragArea" Grid.Column="2" Background="Transparent" IsVisible="False"/>
  </Grid>
  <Border x:Name="MainHeader" Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="24,14">
   <DockPanel>
    <Image DockPanel.Dock="Left" Source="/Assets/karaoke-toolkit.png" Width="40" Height="40" Margin="0,0,12,0"/>
    <StackPanel VerticalAlignment="Center" Spacing="2">
     <TextBlock Text="{x:Static core:ApplicationInfo.Name}" Classes="heading1"/>
     <TextBlock Text="Convert, validate and organise your karaoke collection." FontSize="{DynamicResource SmallTextSize}" Opacity="0.65"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2" x:Name="OperationWorkspace" RowDefinitions="*,Auto">
  <vm:OperationPickerView Margin="24,20" x:Name="OperationPicker"
                          IsVisible="{Binding !ShowProgress, FallbackValue=True}">
   <vm:OperationPickerView.SourcePanel>
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
     <Grid>
      <StackPanel Spacing="8" IsVisible="{Binding NeedsSource}">
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Clear" Command="{Binding ClearInputsCommand}" Padding="10,4"
                AutomationProperties.Name="Clear selected files and folders"/>
       </Grid>
       <TextBox Text="{Binding FolderPath}" IsEnabled="{Binding CanChooseSource}" PlaceholderText="Choose a source or type a path…"
                AutomationProperties.Name="{Binding SourceLabel}"/>
       <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
        <Button Content="Add Folders…" Click="BrowseFolder_Click" IsEnabled="{Binding CanChooseSource}"/>
        <Button Grid.Column="1" Content="Add Files…" Click="BrowseFiles_Click" IsEnabled="{Binding CanChooseFiles}"/>
       </Grid>
       <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" MaxHeight="36" FontSize="{DynamicResource SmallTextSize}" Opacity="0.65" ToolTip.Tip="{Binding SourceSummary}"/>
      </StackPanel>
      <TextBlock Text="{Binding SourceInstruction}" IsVisible="{Binding !NeedsSource}" TextWrapping="Wrap"/>
     </Grid>
    </Border>
   </vm:OperationPickerView.SourcePanel>
  </vm:OperationPickerView>
  <vm:OperationProgressView Margin="24,16" IsVisible="{Binding ShowProgress, FallbackValue=False}"/>
  <Border Grid.Row="1" Classes="windowFooter" Padding="{x:Static shared:WindowSpacing.ContentInset}">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="{x:Static shared:WindowSpacing.FooterButtonGap}">
     <Grid ColumnDefinitions="*,Auto"
           ColumnSpacing="{x:Static shared:WindowSpacing.StatusProgressGap}" VerticalAlignment="Center">
      <shared:StatusBar Message="{Binding FooterStatusMessage, FallbackValue='Starting Karaoke Toolkit…'}"
                        Kind="{Binding FooterStatusKind}" VerticalAlignment="Center"/>
      <ProgressBar Grid.Column="1" IsVisible="{Binding ShowFooterProgress}" IsIndeterminate="True"
                   Width="{x:Static shared:WindowSpacing.StatusProgressWidth}" VerticalAlignment="Center"
                   AutomationProperties.Name="Preparation progress"/>
     </Grid>
     <Button Grid.Column="1" Content="Recover…" Command="{Binding CheckRecoveryCommand}" IsVisible="{Binding RecoveryAvailable}"
             IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding RecoveryMessage}"/>
     <Button Grid.Column="2" Content="View Last Run Report…" Click="Results_Click" IsEnabled="{Binding CanViewReport}"/>
     <Button Grid.Column="3" Content="Back" Click="Back_Click" IsVisible="{Binding ShowProgress, FallbackValue=False}"/>
     <Grid Grid.Column="4">
      <Button Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding !IsBusy, FallbackValue=True}" MinWidth="105" Classes="accent"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy, FallbackValue=False}" MinWidth="105"/>
     </Grid>
    </Grid>
  </Border>
  </Grid>
  <ContentControl Grid.Row="2" x:Name="OperationPreview" IsVisible="False"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid>
</Window>
