<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KaraokeToolkit.App.Features.Tagging" xmlns:shared="using:KaraokeToolkit.App.Shared" x:Class="KaraokeToolkit.App.Features.Tagging.TaggingPreviewView"
        x:DataType="vm:TaggingViewModel">
  <UserControl.Styles>
    <Style Selector="ComboBox.filenamePattern /template/ TextBox#PART_EditableTextBox">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
  <Grid Margin="{x:Static shared:WindowSpacing.ContentInset}" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="14">
    <TextBlock Text="Tag Karaoke Files" Classes="heading1"/>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <ComboBox Classes="filenamePattern" ItemsSource="{Binding Patterns}" Text="{Binding Pattern, Mode=TwoWay}" IsEditable="True"
                Padding="11,5"
                HorizontalAlignment="Stretch" PlaceholderText="Filename pattern"
                AutomationProperties.Name="Filename pattern" ToolTip.Tip="Choose a built-in or previously accepted pattern, or type your own."/>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding PreviewCommand}" MinWidth="100"/>
    </Grid>
    <TextBlock Grid.Row="2" Text="%DISC% → Album · %TRACK% → numeric Track · %ARTIST% → Artist · %TITLE% → Title. Reorder fields and type any separators. ZIPs use the archive filename."
               TextWrapping="Wrap" FontSize="{DynamicResource SmallTextSize}" Opacity="0.8"/>
    <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Select all" Command="{Binding SelectAllCommand}"/>
        <Button Content="Deselect all" Command="{Binding DeselectAllCommand}"/>
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectionMode="Single" IsEnabled="{Binding CanPreview}">
        <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:TaggingRow">
          <StackPanel Spacing="6" Margin="4,8">
            <CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding Path}"/>
            <Grid ColumnDefinitions="*,70,*,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8" IsEnabled="{Binding CanEdit}">
              <TextBlock Text="Album / disc" FontSize="{DynamicResource SmallTextSize}" Opacity="0.7"/>
              <TextBlock Grid.Column="1" Text="Track" FontSize="{DynamicResource SmallTextSize}" Opacity="0.7"/>
              <TextBlock Grid.Column="2" Text="Artist" FontSize="{DynamicResource SmallTextSize}" Opacity="0.7"/>
              <TextBlock Grid.Column="3" Text="Title" FontSize="{DynamicResource SmallTextSize}" Opacity="0.7"/>
              <TextBox Grid.Row="1" Text="{Binding Album}" PlaceholderText="Album / disc" ToolTip.Tip="Album (karaoke disc identifier)"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Track}" PlaceholderText="Track" ToolTip.Tip="Numeric track"/>
              <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Artist}" PlaceholderText="Artist" ToolTip.Tip="Artist"/>
              <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Title}" PlaceholderText="Title" ToolTip.Tip="Title"/>
            </Grid>
            <TextBlock Text="{Binding Existing}" FontSize="{DynamicResource SmallTextSize}" Opacity="0.65" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <StackPanel Grid.Row="4" Spacing="5">
      <CheckBox Content="Fill empty fields only" IsChecked="{Binding FillEmptyOnly}" ToolTip.Tip="Keep existing Album, Track, Artist and Title when they are already populated."/>
      <CheckBox Content="Clear existing comments" IsChecked="{Binding ClearComments}"/>
      <CheckBox Content="Clear other descriptive tags" IsChecked="{Binding ClearOtherDescriptiveTags}"
                ToolTip.Tip="Remove old genre, year, lyrics, composer, sort fields, numeric disc and totals. Technical playback metadata and artwork are preserved where the container supports them."/>
      <TextBlock Text="Files are updated in place. Audio/video is not re-encoded; CDG is kept. ZIPs use your compression settings. Delete Originals does not apply."
                 TextWrapping="Wrap" FontSize="{DynamicResource SmallTextSize}" Opacity="0.7"/>
    </StackPanel>
    <Border Grid.Row="5" Classes="windowFooter dialog">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{x:Static shared:WindowSpacing.StatusProgressGap}" VerticalAlignment="Center">
          <shared:StatusBar Message="{Binding Status}" Kind="{Binding StatusSeverity}" VerticalAlignment="Center"/>
          <ProgressBar Grid.Column="1" Width="{x:Static shared:WindowSpacing.StatusProgressWidth}" VerticalAlignment="Center"
                       IsVisible="{Binding PreviewProgress.IsVisible}" IsIndeterminate="{Binding PreviewProgress.IsIndeterminate}"
                       Value="{Binding PreviewProgress.Percent, Mode=OneWay}"/>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="{x:Static shared:WindowSpacing.FooterButtonGap}">
          <Button Content="Back" Click="Back_Click" MinWidth="90"/>
          <Button Content="Apply Tags" Classes.accent="{Binding CanApply}" IsEnabled="{Binding CanApply}" Click="Apply_Click" MinWidth="110"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
