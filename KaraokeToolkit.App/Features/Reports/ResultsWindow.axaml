<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shared="using:KaraokeToolkit.App.Shared" xmlns:core="using:KaraokeToolkit.Core"
 xmlns:vm="using:KaraokeToolkit.App.Features.Reports" x:Class="KaraokeToolkit.App.Features.Reports.ResultsWindow" x:DataType="vm:ResultsViewModel"
 Title="{x:Static shared:WindowTitles.LastRunReport}" Width="980" Height="650" MinWidth="800" MinHeight="520" WindowStartupLocation="CenterOwner">
 <Grid Margin="{x:Static shared:WindowSpacing.ContentInset}" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
  <TextBlock Text="{Binding Title}" Classes="heading1"/>
  <TextBlock Grid.Row="1" Text="{Binding HeaderSummary}" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
   <TextBlock Text="Show" VerticalAlignment="Center"/>
   <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="210"/>
   <Button Content="Retry Failed" Click="Retry_Click" IsEnabled="{Binding CanRetry}"/>
   <Button Content="Open Output Folder" Click="Open_Click" IsEnabled="{Binding CanEdit}"/>
   <Button Content="Save Report…" Click="Save_Click" IsEnabled="{Binding CanEdit}"/>
  </StackPanel>
  <ListBox Grid.Row="3" x:Name="ResultsList" ItemsSource="{Binding Rows}" SelectionMode="Multiple" IsEnabled="{Binding CanEdit}">
   <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ReportRow">
    <Grid ColumnDefinitions="105,*" Margin="4,8" ColumnSpacing="12">
     <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
     <StackPanel Grid.Column="1" Spacing="4">
      <TextBlock Text="{Binding Source}" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Outputs}" TextWrapping="Wrap" Opacity="0.65" FontSize="{DynamicResource SmallTextSize}"/>
     </StackPanel>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Border Grid.Row="4" Classes="windowFooter dialog">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{x:Static shared:WindowSpacing.FooterButtonGap}">
     <shared:StatusBar Message="{Binding Message}" Kind="{Binding MessageSeverity}" VerticalAlignment="Center"/>
     <Button Grid.Column="1" Content="Move Selected to Damaged…" Click="Move_Click" IsVisible="{Binding IsValidation}" IsEnabled="{Binding CanEdit}"/>
     <Button Grid.Column="2" Content="Close" Click="Close_Click" IsEnabled="{Binding CanEdit}" MinWidth="85"/>
    </Grid>
  </Border>
 </Grid>
</Window>
