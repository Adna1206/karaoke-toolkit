<Project>
  <PropertyGroup>
    <FFmpegRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</FFmpegRid>
    <FFmpegRid Condition="'$(FFmpegRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</FFmpegRid>
    <FFmpegPowerShell Condition="$([MSBuild]::IsOSPlatform('Windows'))">powershell.exe</FFmpegPowerShell>
    <FFmpegPowerShell Condition="'$(FFmpegPowerShell)' == ''">pwsh</FFmpegPowerShell>
  </PropertyGroup>
  <Target Name="PrepareFFmpeg" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' And ('$(MSBuildProjectName)' == 'KaraokeToolkit.App' Or '$(MSBuildProjectName)' == 'KaraokeToolkit.Cli' Or '$(MSBuildProjectName)' == 'KaraokeToolkit.Tests') And '$(SkipFFmpegPrepare)' != 'true'">
    <Exec Command="&quot;$(FFmpegPowerShell)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts/ffmpeg/Prepare.ps1&quot; -RuntimeIdentifier &quot;$(FFmpegRid)&quot; -OutputDirectory &quot;$(TargetDir)ffmpeg&quot;" />
  </Target>
  <Target Name="PrepareCdrdao" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' And ('$(MSBuildProjectName)' == 'KaraokeToolkit.App' Or '$(MSBuildProjectName)' == 'KaraokeToolkit.Tests') And '$(SkipCdrdaoPrepare)' != 'true'">
    <Exec Command="&quot;$(FFmpegPowerShell)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts/cdrdao/Prepare.ps1&quot; -RuntimeIdentifier &quot;$(FFmpegRid)&quot; -OutputDirectory &quot;$(TargetDir)cdrdao&quot;" />
  </Target>
  <Target Name="PublishDiscReader" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="PrepareCdrdao" Condition="'$(MSBuildProjectName)' == 'KaraokeToolkit.App'">
    <ItemGroup>
      <_DiscReaderPublish Include="$(TargetDir)cdrdao/**/*" />
      <ResolvedFileToPublish Include="@(_DiscReaderPublish)">
        <RelativePath>cdrdao/%(_DiscReaderPublish.RecursiveDir)%(_DiscReaderPublish.Filename)%(_DiscReaderPublish.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="PublishFFmpeg" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="PrepareFFmpeg" Condition="'$(MSBuildProjectName)' == 'KaraokeToolkit.App' Or '$(MSBuildProjectName)' == 'KaraokeToolkit.Cli'">
    <ItemGroup>
      <_FFmpegPublish Include="$(TargetDir)ffmpeg/**/*" />
      <ResolvedFileToPublish Include="@(_FFmpegPublish)">
        <RelativePath>ffmpeg/%(_FFmpegPublish.RecursiveDir)%(_FFmpegPublish.Filename)%(_FFmpegPublish.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
